<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:controls="clr-namespace:Zenith.App.Controls">

    <!-- ═══════════════════════════════════════════════════════════════════
         ZENITH — Authentic Microsoft Edge Windows 10 1507 "Spartan" Design
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Backgrounds matching startpage.png & Windows 10 build 1507 -->
    <SolidColorBrush x:Key="WindowBg"            Color="#F2F2F2" />
    <SolidColorBrush x:Key="TabBarBg"            Color="#CCCCCC" /> <!-- Title bar gray -->
    <SolidColorBrush x:Key="ToolbarBg"           Color="#F2F2F2" />
    <SolidColorBrush x:Key="TabActiveBg"         Color="#F2F2F2" /> <!-- Seamless with toolbar -->
    <SolidColorBrush x:Key="TabInactiveBg"       Color="#CCCCCC" />
    <SolidColorBrush x:Key="TabHoverBg"          Color="#BFBFBF" />
    <SolidColorBrush x:Key="AddressBarBg"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusBarBg"         Color="#F2F2F2" />
    <SolidColorBrush x:Key="SidePaneBg"          Color="#F2F2F2" />

    <!-- Borders / Strokes -->
    <SolidColorBrush x:Key="TabBorderBrush"       Color="#BDBDBD" />
    <SolidColorBrush x:Key="ToolbarBorderBrush"   Color="#D0D0D0" />
    <SolidColorBrush x:Key="AddressBarBorder"      Color="#D0D0D0" />
    <SolidColorBrush x:Key="AddressBarFocusBorder" Color="#0078D7" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"         Color="#000000" />
    <SolidColorBrush x:Key="TextSecondary"       Color="#555555" />
    <SolidColorBrush x:Key="TextMuted"           Color="#767676" />
    <SolidColorBrush x:Key="TextDisabled"        Color="#A0A0A0" />

    <!-- Accent (Windows 10 Blue) -->
    <SolidColorBrush x:Key="AccentBrush"         Color="#0078D7" />
    <SolidColorBrush x:Key="AccentHoverBrush"    Color="#1A86DF" />
    <SolidColorBrush x:Key="AccentPressedBrush"  Color="#006CC3" />

    <!-- Button states -->
    <SolidColorBrush x:Key="BtnHoverBg"          Color="#E5E5E5" />
    <SolidColorBrush x:Key="BtnPressedBg"        Color="#CCCCCC" />

    <!-- ═══════════════════════════════════════════════════════════════════
         NAVIGATION BUTTON — flat, subtle hover, matching Edge 1507
    ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="Foreground"       Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderThickness"  Value="0" />
        <Setter Property="Width"            Value="42" />
        <Setter Property="Height"           Value="40" />
        <Setter Property="FontSize"         Value="15" />
        <Setter Property="FontFamily"       Value="Segoe MDL2 Assets, Segoe UI Symbol" />
        <Setter Property="Cursor"           Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBg}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnPressedBg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         TAB BUTTON — Edge 1507 flat rectangular tab with Window icon & ProgressRing
    ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="TabButtonStyle" TargetType="RadioButton">
        <Setter Property="Background"       Value="{StaticResource TabInactiveBg}" />
        <Setter Property="Foreground"       Value="{StaticResource TextSecondary}" />
        <Setter Property="Height"           Value="32" />
        <Setter Property="MinWidth"         Value="140" />
        <Setter Property="MaxWidth"         Value="240" />
        <Setter Property="Margin"           Value="0,0,0,0" />
        <Setter Property="Cursor"           Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily"       Value="Segoe UI" />
        <Setter Property="FontSize"         Value="12" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#BDBDBD"
                            BorderThickness="0,0,1,0"
                            Padding="8,0,6,0"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"  />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Icon / Favicon / Loading Spinner -->
                            <Grid Grid.Column="0" Width="16" Height="16"
                                  VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Default Webpage / Window Icon matching Edge 1507 startpage.png -->
                                <TextBlock x:Name="DefaultIcon"
                                           Text="&#xE737;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="#555555"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <!-- Website Favicon -->
                                <Image x:Name="FaviconImage"
                                       Source="{Binding Favicon}"
                                       Width="16" Height="16"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="Collapsed" />

                                <!-- Authentic Windows 10 ProgressRing -->
                                <controls:ProgressRing x:Name="LoadingSpinner"
                                                       IsActive="{Binding IsLoading}"
                                                       Foreground="#555555"
                                                       Width="16" Height="16"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Visibility="Collapsed" />
                            </Grid>

                            <!-- Column 1: Audio playing indicator icon right after favicon -->
                            <TextBlock x:Name="AudioIcon"
                                       Grid.Column="1"
                                       Text="&#xE767;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="#555555"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       ToolTip="Playing audio"
                                       Visibility="Collapsed" />

                            <!-- Column 2: Tab title text -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Margin="8,0,4,0"
                                       Foreground="{TemplateBinding Foreground}" />

                            <!-- Column 3: Close button -->
                            <Button x:Name="CloseBtn"
                                    Grid.Column="3"
                                    Width="18" Height="18"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Content="&#xE8BB;"
                                    Foreground="#666666"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Opacity="0"
                                    Command="{Binding AnimatedCloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBd" Property="Background" Value="#C42B1C" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover: show close button, lighten tab -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource TabHoverBg}" />
                            <Setter TargetName="CloseBtn" Property="Opacity" Value="1" />
                        </Trigger>

                        <!-- Active tab: background becomes seamless with toolbar (#F2F2F2) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource TabActiveBg}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter TargetName="CloseBtn" Property="Opacity" Value="1" />
                        </Trigger>

                        <!-- When tab has a Favicon: hide DefaultIcon and show FaviconImage -->
                        <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                            <Setter TargetName="DefaultIcon"   Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FaviconImage"  Property="Visibility" Value="Visible"   />
                        </DataTrigger>

                        <!-- When tab is Loading: hide DefaultIcon and FaviconImage, show LoadingSpinner -->
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter TargetName="DefaultIcon"    Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FaviconImage"   Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LoadingSpinner" Property="Visibility" Value="Visible"   />
                        </DataTrigger>

                        <!-- When tab is playing audio: show AudioIcon -->
                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                            <Setter TargetName="AudioIcon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         ADDRESS BAR TEXTBOX — Edge 1507 style
    ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="AddressBoxStyle" TargetType="TextBox">
        <Setter Property="Background"               Value="{StaticResource AddressBarBg}" />
        <Setter Property="Foreground"               Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush"              Value="{StaticResource AddressBarBorder}" />
        <Setter Property="BorderThickness"          Value="1" />
        <Setter Property="FontSize"                 Value="13" />
        <Setter Property="FontFamily"               Value="Segoe UI" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle"         Value="{x:Null}" />
        <Setter Property="CaretBrush"               Value="{StaticResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="6,0,6,0"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource AddressBarFocusBorder}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
